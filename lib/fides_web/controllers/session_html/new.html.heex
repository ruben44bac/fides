<Layouts.app flash={@flash}>
  <div class="mx-auto mt-6 w-full max-w-md sm:mt-16">
    <.panel class="p-8">
      <div class="flex items-center gap-3">
        <span class="flex size-10 items-center justify-center rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 text-base font-bold text-white shadow-sm shadow-orange-500/30">
          F
        </span>
        <div>
          <h1 class="text-lg font-semibold tracking-tight">Sign in to Fides</h1>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            Your password, then the code from your authenticator.
          </p>
        </div>
      </div>

      <.form
        for={@form}
        id="sign-in-form"
        action={~p"/backoffice/sign-in"}
        method="post"
        class="mt-8 space-y-5"
      >
        <div
          :if={@error}
          id="sign-in-error"
          role="alert"
          class="flex items-start gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300"
        >
          <.icon name="hero-exclamation-triangle-mini" class="mt-0.5 size-4 shrink-0" />
          <span>{@error}</span>
        </div>

        <.field field={@form[:email]} type="email" label="Email" autocomplete="username" required />
        <.field
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          required
        />
        <.field
          field={@form[:totp_code]}
          label="Code"
          inputmode="numeric"
          autocomplete="one-time-code"
          placeholder="000000"
          required
        />

        <.action variant="primary" type="submit" class="w-full" phx-disable-with="Signing in…">
          Sign in <.icon name="hero-arrow-right-mini" class="size-4" />
        </.action>
      </.form>
    </.panel>

    <div
      :if={Fides.Accounts.Demo.enabled?()}
      id="demo-staff"
      class="mt-6 rounded-2xl border border-dashed border-zinc-300 px-5 py-4 text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400"
    >
      <p class="font-medium text-zinc-700 dark:text-zinc-300">Demo staff</p>
      <p class="mt-1">
        Any of
        <span
          :for={user <- Fides.Accounts.Demo.users()}
          class="mr-1 font-mono text-xs text-zinc-700 dark:text-zinc-300"
        >
          {user.email}
        </span>
        with the password <span class="font-mono text-xs text-zinc-700 dark:text-zinc-300">{Fides.Accounts.Demo.password()}</span>.
        The code comes from <span class="font-mono text-xs">mix fides.code HANDLE</span>
        or the Postman collection.
      </p>
    </div>
  </div>
</Layouts.app>
