# Every environment variable Fides and its mocks app read. Copy it to .env, which git
# ignores, and load it with `set -a; source .env; set +a` or with direnv. Development
# and tests have defaults for all of them; production requires the ones marked so.

# --- Database ------------------------------------------------------------------
# Development and tests: the port of the PostgreSQL from deploy/compose.yml.
FIDES_DB_PORT=5434
# Production, required: ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=
POOL_SIZE=10

# --- Web -------------------------------------------------------------------------
PORT=4000
# Production, required: the public host, and a secret from `mix phx.gen.secret`.
PHX_HOST=
SECRET_KEY_BASE=
# Set to any value to start the web server from a release.
PHX_SERVER=
# Clustering of the nodes, when there is one: a DNS query.
DNS_CLUSTER_QUERY=

# --- Keys, production, required: 32 random bytes in base64, `openssl rand -base64 32` ---
# Encrypts personal data at rest. Rotating it needs the old key kept as well.
FIDES_ENCRYPTION_KEY=
# Keyed hashes that find holders by document and email. Rotating it loses the lookups.
FIDES_BLIND_INDEX_KEY=
# Signs staff bearer tokens. Changing it signs every staff user out.
FIDES_STAFF_TOKEN_KEY=

# --- Bank providers ------------------------------------------------------------
# Where the providers answer: the mocks app in development, the real ones elsewhere.
# Production, required.
FIDES_PROVIDERS_URL=http://localhost:4010
# What asynchronous providers sign their webhooks with. Production, required.
FIDES_PROVIDER_WEBHOOK_SECRET=fides development provider webhook secret

# --- Evidence and mail -------------------------------------------------------------
# The commit the running code was built from, recorded with every audited change.
FIDES_CODE_SHA=
# Production mail delivery; without them nothing is sent.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Development tools -----------------------------------------------------------
# Where `mix fides.token` signs a demo staff user in.
FIDES_URL=http://localhost:4000
# Lets several test runs share one PostgreSQL, each on its own database.
MIX_TEST_PARTITION=

# --- Mocks app (mocks/) -----------------------------------------------------------
MOCKS_PORT=4010
# Where Mexico's provider delivers its webhook, and the secret it signs with: the same
# as FIDES_PROVIDER_WEBHOOK_SECRET.
MOCKS_FIDES_URL=http://localhost:4000
MOCKS_WEBHOOK_SECRET=fides development provider webhook secret
# Knobs for demos and chaos: a latency for every answer, the share of calls (0 to 1)
# that fail, never answer or answer something malformed, how long Mexico's provider
# waits before delivering, and how many extra times it delivers each webhook.
MOCKS_LATENCY_MS=0
MOCKS_ERROR_RATE=0
MOCKS_TIMEOUT_RATE=0
MOCKS_MALFORMED_RATE=0
MOCKS_WEBHOOK_DELAY_MS=1000
MOCKS_WEBHOOK_DUPLICATES=0
